{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Personal Computer Typology PostgreSQL database. Single AZ; restricted to one IPv4 address; TLS required.",
  "Parameters": {
    "PostgreSQLVersion": {
      "Type": "String",
      "Description": "Available PostgreSQL 18 minor version, resolved automatically by deploy_aws.py",
      "AllowedPattern": "^18\\.[0-9]+$"
    },
    "AllowedClientCidr": {
      "Type": "String",
      "Description": "Your current public IPv4 address followed by /32",
      "AllowedPattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
    },
    "DatabaseInstanceClass": {
      "Type": "String",
      "Default": "db.t4g.micro",
      "AllowedValues": [
        "db.t4g.micro",
        "db.t4g.small"
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.84.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}"
            }
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "SubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.84.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "SubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.84.2.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "RouteA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetA"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "RouteB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetB"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "PostgreSQL from one approved public IP only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "CidrIp": {
              "Ref": "AllowedClientCidr"
            }
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "SubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Typology database subnets",
        "SubnetIds": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "Parameters": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Description": "Require TLS for every PostgreSQL connection",
        "Family": "postgres18",
        "Parameters": {
          "rds.force_ssl": "1"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "DependsOn": [
        "InternetRoute",
        "RouteA",
        "RouteB",
        "DatabaseLogs"
      ],
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot",
      "Properties": {
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "PostgreSQLVersion"
        },
        "DBInstanceClass": {
          "Ref": "DatabaseInstanceClass"
        },
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "DBName": "typology",
        "MasterUsername": "typology_admin",
        "ManageMasterUserPassword": true,
        "Port": "5432",
        "DBSubnetGroupName": {
          "Ref": "SubnetGroup"
        },
        "VPCSecurityGroups": [
          {
            "Fn::GetAtt": [
              "SecurityGroup",
              "GroupId"
            ]
          }
        ],
        "DBParameterGroupName": {
          "Ref": "Parameters"
        },
        "PubliclyAccessible": true,
        "MultiAZ": false,
        "BackupRetentionPeriod": 1,
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "CopyTagsToSnapshot": true,
        "EnableCloudwatchLogsExports": [
          "postgresql"
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "ComputerTypology"
          },
          {
            "Key": "created_by",
            "Value": "rds-oss-skill"
          },
          {
            "Key": "generation_model",
            "Value": "gpt-6"
          }
        ],
        "DBInstanceIdentifier": {
          "Fn::Sub": "${AWS::StackName}-db"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Small single-user daily uploads; Single AZ minimizes the fixed monthly bill.",
          "must": [
            "Encrypted storage and verified TLS.",
            "Preserve deletion protection, one-day backups and replacement snapshots; longer backups require an account plan that allows them.",
            "20 GB gp3 and db.t4g.micro by default; no storage autoscaling."
          ]
        }
      }
    },
    "DatabaseLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/rds/instance/${AWS::StackName}-db/postgresql"
        },
        "RetentionInDays": 7
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Support a personal daily activity archive with direct TLS connections and no NAT gateway.",
          "must": [
            "Keep database access restricted to the approved client IPv4 /32."
          ]
        }
      }
    }
  },
  "Outputs": {
    "Endpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "Port": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Port"
        ]
      }
    },
    "DatabaseName": {
      "Value": "typology"
    },
    "DatabaseIdentifier": {
      "Value": {
        "Ref": "Database"
      }
    },
    "MasterSecretArn": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "MasterUserSecret.SecretArn"
        ]
      }
    },
    "SecurityGroupId": {
      "Value": {
        "Ref": "SecurityGroup"
      }
    }
  },
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    }
  }
}
