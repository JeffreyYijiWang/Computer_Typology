{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Personal Computer Typology PostgreSQL database. Single AZ; restricted to one IPv4 address; TLS required.",
  "Parameters": {
    "PostgreSQLVersion": {
      "Type": "String",
      "Description": "Available PostgreSQL 17 minor version, resolved automatically by deploy_aws.py",
      "AllowedPattern": "^17\\.[0-9]+$"
    },
    "AllowedClientCidr": {
      "Type": "String",
      "Description": "Your current public IPv4 address followed by /32",
      "AllowedPattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
    },
    "DatabaseInstanceClass": {
      "Type": "String",
      "Default": "db.t4g.micro",
      "AllowedValues": [
        "db.t4g.micro",
        "db.t4g.small"
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.84.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}"
            }
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "SubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.84.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "SubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.84.2.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "RouteA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetA"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "RouteB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetB"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "PostgreSQL from the owner's current public IP only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "CidrIp": {
              "Ref": "AllowedClientCidr"
            }
          }
        ]
      }
    },
    "SubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Typology database subnets",
        "SubnetIds": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ]
      }
    },
    "Parameters": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Description": "Require TLS for every PostgreSQL connection",
        "Family": "postgres17",
        "Parameters": {
          "rds.force_ssl": "1"
        }
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "DependsOn": [
        "InternetRoute",
        "RouteA",
        "RouteB"
      ],
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot",
      "Properties": {
        "Engine": "postgres",
        "EngineVersion": {"Ref": "PostgreSQLVersion"},
        "DBInstanceClass": {
          "Ref": "DatabaseInstanceClass"
        },
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "DBName": "typology",
        "MasterUsername": "typology_admin",
        "ManageMasterUserPassword": true,
        "Port": "5432",
        "DBSubnetGroupName": {
          "Ref": "SubnetGroup"
        },
        "VPCSecurityGroups": [
          {
            "Fn::GetAtt": [
              "SecurityGroup",
              "GroupId"
            ]
          }
        ],
        "DBParameterGroupName": {
          "Ref": "Parameters"
        },
        "PubliclyAccessible": true,
        "MultiAZ": false,
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "CopyTagsToSnapshot": true,
        "EnableCloudwatchLogsExports": [
          "postgresql"
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "ComputerTypology"
          }
        ]
      }
    }
  },
  "Outputs": {
    "Endpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "Port": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Port"
        ]
      }
    },
    "DatabaseName": {
      "Value": "typology"
    },
    "DatabaseIdentifier": {
      "Value": {
        "Ref": "Database"
      }
    },
    "MasterSecretArn": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "MasterUserSecret.SecretArn"
        ]
      }
    },
    "SecurityGroupId": {
      "Value": {
        "Ref": "SecurityGroup"
      }
    }
  }
}
